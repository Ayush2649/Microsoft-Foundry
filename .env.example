# Copy this file to .env or set the variable in your shell before running the examples.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
CONTENT_SAFETY_KEY=your_content_safety_key_here
DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here
CONTENT_UNDERSTANDING_ENDPOINT=https://your-content-understanding-resource.services.ai.azure.com/
CONTENT_UNDERSTANDING_KEY=your_content_understanding_key_here
PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
PROJECT_RESOURCE_ID=/subscriptions/your-subscription/resourceGroups/your-resource-group/providers/Microsoft.CognitiveServices/accounts/your-account/projects/your-project/connections/your-connection
SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
PROJECT_CONNECTION_NAME=your_project_connection_name
AZURE_LANGUAGE_ENDPOINT=https://your-language-resource.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your_language_api_key_here
APPLICATIONINSIGHTS_CONNECTION_STRING=your_application_insights_connection_string_here